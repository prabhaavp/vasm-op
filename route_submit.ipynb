# --- UI Styling ---
style = {'description_width': '120px'}
layout_full = widgets.Layout(width='100%', margin='2px 0')

# --- Shared UI Components ---
token_input = widgets.Password(description="JWT Token:", placeholder="Paste JWT here", style=style, layout=layout_full)
dongle_input = widgets.Text(description="Dongle ID:", placeholder="Enter Dongle ID", style=style, layout=layout_full)
contact_input = widgets.Text(description="Contact (Opt):", placeholder="Discord handle or Email for notifications", style=style, layout=layout_full)

privacy_dropdown = widgets.Dropdown(
    options=[('Public (Allow training ingestion)', True), ('Private (Revert to private)', False)],
    value=True, description='ASM Visibility:', style=style, layout=layout_full
)

fetch_btn = widgets.Button(description="1. FETCH DEVICE ROUTES", button_style='info', layout=widgets.Layout(width='100%', height='45px', margin='10px 0'))
all_routes_check = widgets.Checkbox(value=False, description="SELECT ALL ROUTES", indent=False, layout=layout_full)
route_list_container = widgets.VBox([], layout=widgets.Layout(width='100%'))
scroll_box = widgets.Box([route_list_container], layout=widgets.Layout(overflow_y='scroll', height='300px', width='100%', border='1px solid #4b5563', padding='5px'))

action_btn = widgets.Button(description="2. INITIATE REMOTE UPLOAD AND BULK SUBMIT", button_style='success', layout=widgets.Layout(width='100%', height='60px', margin='15px 0'))

manual_title = widgets.HTML("<hr><b>Manual Route Submission</b><br><small>If a route does not appear in the list, paste Route IDs below (one per line).</small>")
manual_input = widgets.Textarea(placeholder="dongleid|datetime--segment", layout=widgets.Layout(width='100%', height='100px'))
manual_btn = widgets.Button(description="SUBMIT MANUAL LIST", button_style='warning', layout=widgets.Layout(width='100%', height='40px', margin='5px 0'))

output_log = widgets.Output(layout={'border': '1px solid #4b5563', 'margin': '10px 0', 'padding': '8px', 'font_family': 'monospace'})

# --- Shared Logic ---
def get_headers():
    return {"Authorization": f"JWT {token_input.value.strip()}", "Content-Type": "application/json"}

def send_to_worker(route_ids):
    if not route_ids: return
    try:
        submission_data = {
            "dongle_id": dongle_input.value.strip(),
            "routes": route_ids,
            "contact": contact_input.value.strip() if contact_input.value else "Not provided"
        }
        resp = requests.post(CONTRIBUTION_LOG_ENDPOINT, json=submission_data)
        if resp.status_code == 200:
            print(f"SUCCESS: {len(route_ids)} routes registered for ingestion.")
        else:
            print(f"WARNING: Worker returned status {resp.status_code}.")
    except Exception as e:
        print(f"ERROR: Worker submission failed: {e}")

def check_already_uploaded(file_fn, existing_urls):
    if "log" in file_fn:
        return any("log.zst" in url or "log.bz2" in url for url in existing_urls)
    return any(file_fn in url for url in existing_urls)

# --- Event Handlers ---
def fetch_routes(b):
    with output_log:
        clear_output()
        if not token_input.value or not dongle_input.value:
            print("STATUS: JWT and Dongle ID are required.")
            return
        print("STATUS: Connecting to Comma API...")
        try:
            r = requests.get(f"{API_HOST}/devices/{dongle_input.value.strip()}/routes", headers=get_headers())
            r.raise_for_status()
            data = r.json()
            widgets_list = []
            for rt in data:
                label = f"{rt.get('start_time')} | {rt.get('fullname')}"
                cb = widgets.Checkbox(value=all_routes_check.value, description=label, indent=False, layout=layout_full)
                cb.route_data = rt
                widgets_list.append(cb)
            route_list_container.children = widgets_list
            print(f"SUCCESS: Found {len(widgets_list)} routes. Select drives with traffic or lane changes.")
        except Exception as e: print(f"ERROR: Connection failed: {e}")

def run_upload_process(b):
    selected = [cb for cb in route_list_container.children if cb.value]
    target_files = ["rlog.zst", "qlog.zst", "dcamera.hevc"]
    bulk_route_ids = []

    if not selected:
        with output_log: print("STATUS: No routes selected.")
        return

    with output_log:
        clear_output()
        for cb in selected:
            rid = cb.route_data['fullname']
            log_id = rid.split('|')[1]
            bulk_route_ids.append(rid)
            print(f"SYNCING: {rid}")
            try:
                patch_url = f"{API_HOST}/route/{rid.replace('|', '%7C')}/"
                requests.patch(patch_url, headers=get_headers(), json={"is_public": privacy_dropdown.value})

                r_info = requests.get(f"{API_HOST}/route/{rid}", headers=get_headers()).json()
                uploaded = requests.get(f"{API_HOST}/route/{rid}/files", headers=get_headers()).json()
                num_segs = r_info.get('maxqlog', r_info.get('segments', 0)) + 1

                missing = []
                for i in range(num_segs):
                    existing = uploaded.get(str(i), [])
                    for f in target_files:
                        if not check_already_uploaded(f, existing): missing.append(f"{log_id}--{i}/{f}")

                if missing:
                    urls = requests.post(f"{API_HOST}/{dongle_input.value.strip()}/upload_urls/", headers=get_headers(), json={"paths": missing}).json()
                    files_data = [{"fn": p, "url": u['url'], "headers": u.get('headers', {"x-ms-blob-type": "BlockBlob"})} for p, u in zip(missing, urls)]
                    requests.post(f"{ATHENA_HOST}/{dongle_input.value.strip()}", headers=get_headers(),
                                 json={"method": "uploadFilesToUrls", "jsonrpc": "2.0", "id": 0, "params": {"files_data": files_data}})
                    print(f" -> {len(missing)} files queued for remote upload.")
                else: print(" -> Assets verified on server.")
            except Exception as e: print(f" -> ERROR: {e}")

        send_to_worker(bulk_route_ids)

def run_manual_submit(b):
    routes = [r.strip() for r in manual_input.value.split('\n') if r.strip()]
    with output_log:
        clear_output()
        if not routes:
            print("STATUS: Manual input is empty.")
            return
        print(f"STATUS: Registering {len(routes)} manual entries...")
        send_to_worker(routes)

# --- Assembly ---
all_routes_check.observe(lambda c: [setattr(cb, 'value', c['new']) for cb in route_list_container.children], names='value')
fetch_btn.on_click(fetch_routes)
action_btn.on_click(run_upload_process)
manual_btn.on_click(run_manual_submit)

display(widgets.VBox([
    widgets.HTML(title_html),
    widgets.HTML(project_info_html),
    widgets.HTML(security_warning_html),
    widgets.HTML(auth_instructions_html),
    token_input, dongle_input, contact_input,
    fetch_btn,
    widgets.HTML("<b>Route Selection:</b>"),
    all_routes_check, scroll_box, privacy_dropdown, action_btn,
    manual_title, manual_input, manual_btn,
    output_log,
    widgets.HTML(credits_html)
], layout=widgets.Layout(width='100%', max_width='700px', margin='0 auto')))